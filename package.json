{
  "name": "servo",
  "private": true,
  "workspaces": [
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:server": "npm run dev -w @servo/server",
    "dev:client": "npm run dev -w @servo/client",
    "build": "turbo build",
    "test": "turbo test",
    "test:server": "npm test -w @servo/server",
    "test:client": "npm test -w @servo/client",
    "test:e2e": "npx playwright test",
    "lint": "turbo lint",
    "db:migrate": "npm run db:migrate -w @servo/server",
    "db:seed": "npm run db:seed -w @servo/server",
    "db:studio": "npm run db:studio -w @servo/server"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "npm@11.16.0"
}
